# Copy this file to .env, enter your keys locally, then chmod 600 .env.
# .env is ignored by Git and loaded by scripts/serve_local.py on startup.
RA_GNEWS_API_KEY=
RA_THENEWSAPI_API_KEY=

# Conservative limits below the free-plan 100 requests per UTC day.
RA_GNEWS_DAILY_LIMIT=95
RA_THENEWSAPI_DAILY_LIMIT=95

# Optional article recovery. Each provider gets 20 attempts per UTC day by default.
RA_BRAVE_API_KEY=
RA_JINA_API_KEY=
RA_FIRECRAWL_API_KEY=
RA_BRAVE_DAILY_LIMIT=20
RA_JINA_DAILY_LIMIT=20
RA_FIRECRAWL_DAILY_LIMIT=20
